# The operator puts these values in Dockge. Never send back or commit the key.
PROTON_WIREGUARD_PRIVATE_KEY=replace_with_the_PrivateKey_value
PROTON_SERVER_COUNTRIES=United Kingdom
TZ=Europe/London
RELAY_VERSION=v2.5.0

# Optional troubleshooting settings.
GLUETUN_POLL_SECONDS=15
RELAY_VERBOSE=off

